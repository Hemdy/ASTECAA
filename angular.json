{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "1e1de97b-a744-405a-8b5a-0397bb3d01ce"
  },
  "newProjectRoot": "apps",
  "projects": {
    "website": {
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "configurations": {
            "development": {
              "extractLicenses": false,
              "namedChunks": true,
              "optimization": false,
              "sourceMap": true
            },
            "production": {
              "extractLicenses": true,
              "namedChunks": false,
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false
            }
          },
          "options": {
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/website/public"
              }
            ],
            "index": "apps/website/src/index.html",
            "browser": "apps/website/src/main.ts",
            "outputPath": {
              "base": "dist/astecaa",
              "browser": "browser"
            },
            "polyfills": [],
            "scripts": [],
            "styles": ["apps/website/src/global_styles.css"],
            "tsConfig": "apps/website/tsconfig.app.json"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200
          },
          "configurations": {
            "development": {
              "buildTarget": "website:build:development"
            },
            "production": {
              "buildTarget": "website:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      },
      "prefix": "app",
      "projectType": "application",
      "root": "apps/website",
      "schematics": {},
      "sourceRoot": "apps/website/src"
    },
    "admin": {
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "configurations": {
            "development": {
              "extractLicenses": false,
              "namedChunks": true,
              "optimization": false,
              "sourceMap": true
            },
            "production": {
              "extractLicenses": true,
              "namedChunks": false,
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false
            }
          },
          "options": {
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/admin/public"
              },
              {
                "glob": "**/*",
                "input": "apps/website/public"
              }
            ],
            "baseHref": "/",
            "browser": "apps/admin/src/main.ts",
            "deleteOutputPath": true,
            "index": "apps/admin/src/index.html",
            "outputPath": {
              "base": "dist/admin",
              "browser": ""
            },
            "polyfills": [],
            "scripts": [],
            "styles": [
              "apps/website/src/global_styles.css",
              "apps/admin/src/admin.css"
            ],
            "tsConfig": "apps/admin/tsconfig.app.json"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4300
          },
          "configurations": {
            "development": {
              "buildTarget": "admin:build:development"
            },
            "production": {
              "buildTarget": "admin:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      },
      "prefix": "admin",
      "projectType": "application",
      "root": "apps/admin",
      "schematics": {},
      "sourceRoot": "apps/admin/src"
    }
  },
  "version": 1
}
