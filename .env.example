# ASTECAA Environment Configuration Template
# Copy to .env and replace placeholders with your credentials.

APP_ENV=development
LOG_LEVEL=info
ASTEC_API_HOST=127.0.0.1
ASTEC_API_PORT=8000
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

# Better Auth Configuration (Keep secrets server-side)
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Neon Database URLs (TLS required)
# Pooled runtime connection URL for queries and auth sessions:
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<NEON-POOLER-HOST>/<DATABASE>?sslmode=require

# Direct unpooled connection URL used for applying Drizzle Kit migrations:
MIGRATION_DATABASE_URL=postgresql://<MIGRATION_USER>:<PASSWORD>@<NEON-DIRECT-HOST>/<DATABASE>?sslmode=require

# Cloudflare R2 Storage (For Media and Uploads)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET_NAME=astecaa-media
R2_PUBLIC_URL=https://media.astecaa.org

# Resend Email Dispatch
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ASTECAA <notifications@astecaa.org>

# Frontend build variable (Optional in development; defaults to http://localhost:8000)
# ASTECAA_API_URL=https://api.astecaa.org
