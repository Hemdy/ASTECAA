# Safe placeholders only. Copy to apps/api/.env and replace values locally.
# Never use production credentials in local development.

APP_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
ASTEC_API_HOST=127.0.0.1
ASTEC_API_PORT=8000

# Neon pooled runtime URL (TLS required). Used by the Deno database smoke check.
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<NEON-POOLER-HOST>/<DATABASE>?sslmode=require

# Direct, least-privilege development migration URL. Only needed when applying
# reviewed migrations. Keep separate from DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://<MIGRATION_USER>:<PASSWORD>@<NEON-DIRECT-HOST>/<DATABASE>?sslmode=require

# Better Auth development configuration. Keep secrets server-side.
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Planned object-storage variables; not consumed by current code.
STORAGE_ENDPOINT=https://<ACCOUNT-ID>.r2.cloudflarestorage.com
STORAGE_BUCKET=astec-development
STORAGE_ACCESS_KEY_ID=replace-with-development-key-id
STORAGE_SECRET_ACCESS_KEY=replace-with-development-secret
STORAGE_PUBLIC_BASE_URL=
STORAGE_MAX_UPLOAD_BYTES=10485760

# Planned email variables; not consumed by current code.
EMAIL_PROVIDER=unselected
EMAIL_API_KEY=replace-with-development-email-key
EMAIL_FROM="ASTECAA Development <noreply@example.invalid>"
EMAIL_REPLY_TO=

# Optional future telemetry; not consumed by current code.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=astec-api
