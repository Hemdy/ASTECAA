{
  "name": "@astec/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:dependencies": "pnpm --filter @astec/types run build && pnpm --filter @astec/config run build && pnpm --filter @astec/database run build && pnpm --filter @astec/validation run build",
    "prebuild": "pnpm run build:dependencies",
    "build": "tsc",
    "prestart": "pnpm run build:dependencies",
    "start": "node dist/main.js", 
    "prestart:dev": "pnpm run build:dependencies",
    "start:dev": "tsc && node --watch dist/main.js",
    "test": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs test/api-smoke.ts"
  },
  "dependencies": {
    "@astec/config": "workspace:*",
    "@astec/database": "workspace:*",
    "@astec/types": "workspace:*",
    "@astec/validation": "workspace:*",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@better-auth/drizzle-adapter": "^1.7.15",
    "@neondatabase/serverless": "^1.2.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
