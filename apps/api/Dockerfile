FROM denoland/deno:2.9.6

WORKDIR /app
COPY . .

WORKDIR /app/apps/api
RUN deno cache --config=deno.json --frozen src/server.ts

USER deno

ENV APP_ENV=production
ENV ASTEC_API_HOST=0.0.0.0
ENV ASTEC_API_PORT=8000

EXPOSE 8000

CMD ["deno", "run", "--cached-only", "--config=deno.json", "--frozen", "--allow-env=APP_ENV,DATABASE_URL,BETTER_AUTH_SECRET,BETTER_AUTH_SECRETS,BETTER_AUTH_URL,BETTER_AUTH_TRUSTED_ORIGINS,ALLOWED_ORIGINS,ASTEC_API_HOST,ASTEC_API_PORT,FORCE_COLOR,NODE_ENV,TEST,BETTER_AUTH_TELEMETRY,BETTER_AUTH_TELEMETRY_ID,BETTER_AUTH_TELEMETRY_ENDPOINT,BETTER_AUTH_TELEMETRY_DEBUG,PACKAGE_VERSION,USER,USERNAME,NODE_PG_FORCE_NATIVE,PG*", "--allow-net=0.0.0.0:8000,*.neon.tech", "src/server.ts"]
