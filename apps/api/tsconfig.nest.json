{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../..",
    "outDir": ".nest-build",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "baseUrl": "../..",
    "paths": {
      "@astec/types": ["packages/types/src/events.ts"]
    }
  },
  "include": [
    "src/main.ts",
    "src/nest/**/*.ts",
    "../../infrastructure/database/schema.ts",
    "../../infrastructure/database/auth-schema.ts",
    "../../packages/types/src/events.ts",
    "../../packages/types/src/base.ts",
    "../../packages/validation/src/common.ts",
    "../../packages/validation/src/events.ts"
  ],
  "exclude": [".nest-build", "node_modules"]
}
