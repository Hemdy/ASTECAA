{
  "name": "astecaa-monorepo",
  "private": true,
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/write-api-config.mjs",
    "prestart:website": "node scripts/write-api-config.mjs",
    "prestart:admin": "node scripts/write-api-config.mjs",
    "start": "ng serve website",
    "start:website": "ng serve website",
    "start:admin": "ng serve admin",
    "start:api": "pnpm --filter @astec/api start:dev",
    "build:website": "ng build website && node scripts/write-api-config.mjs",
    "build:admin": "ng build admin && node scripts/write-api-config.mjs && node scripts/sync-builds.mjs",
    "build:api": "pnpm --filter @astec/api build",
    "build": "pnpm run build:website && pnpm run build:admin && node scripts/write-api-config.mjs && node scripts/sync-builds.mjs",
    "db:generate": "pnpm --filter @astec/database db:generate",
    "db:migrate": "pnpm --filter @astec/database db:migrate",
    "db:check": "pnpm --filter @astec/database db:check",
    "db:push": "pnpm --filter @astec/database db:push"
  },
  "dependencies": {
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "remixicon": "^4.9.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.5.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  }
}
