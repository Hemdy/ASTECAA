{
  "name": "@astec/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/schema.js",
  "types": "./dist/schema.d.ts",
  "exports": {
    ".": "./dist/schema.js",
    "./schema": "./dist/schema.js",
    "./auth-schema": "./dist/auth-schema.js"
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "pnpm run db:generate && pnpm run db:migrate:apply",
    "db:migrate:apply": "node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:push": "node -e \"console.error('Forbidden: never use Drizzle db push. Generate, review, and migrate SQL instead.'); process.exit(1)\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
